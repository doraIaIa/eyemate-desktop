{
  "name": "eyemate-desktop",
  "private": true,
  "version": "0.1.0-m1",
  "type": "module",
  "scripts": {
    "clean": "node tools/m1/clean.mjs",
    "dev": "npm run build && electron dist/main/main.js --enable-dev-panel",
    "dev:enterprise-demo": "npm run build && electron dist/main/main.js --enterprise-demo",
    "lint": "node tools/m1/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && node tools/m1/copy-assets.mjs",
    "build:msix:m1": "npm run build && node tools/m1/build-msix.mjs",
    "build:msix": "npm run build:msix:m1",
    "build:demo": "npm run build:msix:m1",
    "install:demo:unsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/m1/install-unsigned-demo-msix.ps1",
    "unit": "npm run build && node tools/m1/run-tests.mjs unit",
    "integration": "npm run build && node tools/m1/run-tests.mjs integration",
    "acceptance": "npm run build && node tools/m1/run-electron-smoke.mjs",
    "acceptance:m2": "npm run build && node tools/m2/run-companion-smoke.mjs",
    "acceptance:m3": "npm run build && node tools/m3/run-intelligence-smoke.mjs",
    "acceptance:ui": "npm run build && node tools/ui/run-ui-validation.mjs",
    "acceptance:living-aurora": "npm run build && node tools/ui/run-living-aurora-validation.mjs",
    "acceptance:taste-design-lab": "npm run build && node tools/ui/run-taste-design-lab-validation.mjs",
    "acceptance:clarity-production": "npm run build && node tools/ui/run-clarity-production-validation.mjs",
    "acceptance:dev-panel": "npm run build && node tools/ui/run-dev-panel-validation.mjs",
    "architecture": "node tools/m1/check-architecture.mjs",
    "privacy": "node tools/m1/check-privacy-boundaries.mjs",
    "verify:m1": "npm run lint && npm run typecheck && npm run unit && npm run integration && npm run architecture && npm run privacy && npm run acceptance && npm run build",
    "verify": "npm run verify:m1 && npm run security && npm run accessibility && npm run acceptance:m2 && npm run acceptance:m3 && npm run acceptance:ui",
    "release:verify": "npm run verify && npm run build:msix:m1",
    "release:provenance": "npm run build:msix:m1 && node tools/m4/generate-release-provenance.mjs",
    "pilot:contract": "node tools/pilot/validate-pilot-contract.mjs pilot/feature-matrix.json",
    "test:pilot-contract": "node tools/pilot/run-pilot-contract-fixture-tests.mjs",
    "test:enterprise-demo": "npm run build && node tools/m5/run-enterprise-demo-validation.mjs",
    "camera:validate:pilot": "npm run build && electron tools/pilot/run-camera-validation.mjs",
    "test:camera-harness": "npm run build && electron tools/pilot/run-camera-validation.mjs --smoke",
    "test:camera-runtime": "npm run build && node tools/pilot/run-camera-runtime-integration.mjs",
    "camera:measure:pilot": "npm run build && node tools/pilot/run-camera-runtime-integration.mjs --full-measurement",
    "camera:ground-truth:validate": "node tools/pilot/validate-camera-ground-truth.mjs",
    "test:camera-ground-truth": "node tools/pilot/run-camera-ground-truth-fixture-tests.mjs",
    "test:pdf-export": "npm run build && electron tools/pilot/run-pdf-export-integration.mjs",
    "egress:observe:pilot": "npm run build && node tools/pilot/observe-tcp-egress.mjs",
    "build:msix:beta": "npm run build && node tools/m1/build-msix.mjs --beta",
    "pilot:signing-status": "node tools/pilot/sign-beta-msix.mjs --status",
    "test:signing-interface": "node tools/pilot/run-signing-interface-tests.mjs",
    "pilot:release": "npm run build:msix:beta && node tools/pilot/generate-beta-release.mjs",
    "pilot:verify-bundle": "node tools/pilot/verify-beta-release.mjs",
    "pilot:external-gates": "node tools/pilot/validate-external-gates.mjs",
    "pilot:sensitive-storage-gate": "npm run build && node tools/pilot/check-sensitive-storage-gate.mjs",
    "verify:pilot": "npm run verify && npm run pilot:contract && npm run pilot:external-gates && npm run test:pilot-contract && npm run pilot:sensitive-storage-gate && npm run test:camera-harness && npm run test:camera-runtime && npm run test:pdf-export && npm run egress:observe:pilot && npm run test:signing-interface && npm run pilot:signing-status && npm run pilot:release && npm run pilot:verify-bundle",
    "accessibility": "node tools/m4/check-accessibility.mjs",
    "security": "node tools/m4/check-security-posture.mjs",
    "performance:m4": "npm run build:msix:m1 && node tools/m4/measure-runtime.mjs",
    "test:state:m0": "node candidates/shared/run-state-fixture-tests.mjs",
    "test:electron:m0": "electron candidates/electron/main.mjs --test",
    "test:storage:electron:m0": "node candidates/electron/run-storage-fixture-tests.mjs",
    "test:privacy:m0": "node tools/m0/run-privacy-sink-fixture-tests.mjs",
    "test:msix:m0": "node tools/m0/run-msix-feasibility-fixture-tests.mjs",
    "build:msix:tauri:m0": "node tools/m0/build-msix-feasibility.mjs build tauri --out .m0/msix --sign",
    "build:msix:electron:m0": "node tools/m0/build-msix-feasibility.mjs build electron --out .m0/msix --sign",
    "test:performance:m0": "node tools/m0/run-candidate-performance-fixture-tests.mjs",
    "benchmark:performance:m0": "node tools/m0/run-candidate-performance.mjs",
    "test:cleanup:m0": "node tools/m0/run-m0-cleanup-fixture-tests.mjs",
    "cleanup:m0:dry-run": "node tools/m0/run-m0-cleanup-check.mjs --dry-run",
    "cleanup:m0": "node tools/m0/run-m0-cleanup-check.mjs --apply",
    "check:tauri:m0": "cargo check --manifest-path candidates/tauri/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  }
}
