{
  "name": "eyemate-desktop",
  "private": true,
  "version": "0.1.0-m1",
  "type": "module",
  "scripts": {
    "clean": "node tools/m1/clean.mjs",
    "dev": "npm run build && electron dist/main/main.js",
    "lint": "node tools/m1/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && node tools/m1/copy-assets.mjs",
    "build:msix:m1": "npm run build && node tools/m1/build-msix.mjs",
    "unit": "npm run build && node tools/m1/run-tests.mjs unit",
    "integration": "npm run build && node tools/m1/run-tests.mjs integration",
    "acceptance": "npm run build && node tools/m1/run-electron-smoke.mjs",
    "acceptance:m2": "npm run build && node tools/m2/run-companion-smoke.mjs",
    "acceptance:m3": "npm run build && node tools/m3/run-intelligence-smoke.mjs",
    "acceptance:ui": "npm run build && node tools/ui/run-ui-validation.mjs",
    "architecture": "node tools/m1/check-architecture.mjs",
    "privacy": "node tools/m1/check-privacy-boundaries.mjs",
    "verify:m1": "npm run lint && npm run typecheck && npm run unit && npm run integration && npm run architecture && npm run privacy && npm run acceptance && npm run build",
    "verify": "npm run verify:m1 && npm run security && npm run accessibility && npm run acceptance:m2 && npm run acceptance:m3 && npm run acceptance:ui",
    "release:verify": "npm run verify && npm run build:msix:m1",
    "release:provenance": "npm run build:msix:m1 && node tools/m4/generate-release-provenance.mjs",
    "pilot:contract": "node tools/pilot/validate-pilot-contract.mjs pilot/feature-matrix.json",
    "test:pilot-contract": "node tools/pilot/run-pilot-contract-fixture-tests.mjs",
    "accessibility": "node tools/m4/check-accessibility.mjs",
    "security": "node tools/m4/check-security-posture.mjs",
    "performance:m4": "npm run build:msix:m1 && node tools/m4/measure-runtime.mjs",
    "test:state:m0": "node candidates/shared/run-state-fixture-tests.mjs",
    "test:electron:m0": "electron candidates/electron/main.mjs --test",
    "test:storage:electron:m0": "node candidates/electron/run-storage-fixture-tests.mjs",
    "test:privacy:m0": "node tools/m0/run-privacy-sink-fixture-tests.mjs",
    "test:msix:m0": "node tools/m0/run-msix-feasibility-fixture-tests.mjs",
    "build:msix:tauri:m0": "node tools/m0/build-msix-feasibility.mjs build tauri --out .m0/msix --sign",
    "build:msix:electron:m0": "node tools/m0/build-msix-feasibility.mjs build electron --out .m0/msix --sign",
    "test:performance:m0": "node tools/m0/run-candidate-performance-fixture-tests.mjs",
    "benchmark:performance:m0": "node tools/m0/run-candidate-performance.mjs",
    "test:cleanup:m0": "node tools/m0/run-m0-cleanup-fixture-tests.mjs",
    "cleanup:m0:dry-run": "node tools/m0/run-m0-cleanup-check.mjs --dry-run",
    "cleanup:m0": "node tools/m0/run-m0-cleanup-check.mjs --apply",
    "check:tauri:m0": "cargo check --manifest-path candidates/tauri/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "typescript": "^5.9.3"
  }
}
